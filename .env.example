# ---------------------------------------------------------------------------
# Supabase — find these in Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# SERVER ONLY — never expose this to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# First admin (used by `npm run seed:admin`)
# Keep these values PRIVATE — only in .env.local / Vercel env vars.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-strong-password
ADMIN_FULL_NAME=Admin

# ---------------------------------------------------------------------------
# Optional: Cloudflare Turnstile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL (used in metadata / emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — find these in Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# SERVER ONLY — never expose this to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# First admin (used by `npm run seed:admin` and the SQL seed helper)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL=taujidrana00@gmail.com
ADMIN_EMAIL=taujidrana00@gmail.com
ADMIN_PASSWORD=Tauhidrana00@00@
ADMIN_FULL_NAME=Admin

# ---------------------------------------------------------------------------
# Optional: bot protection on the submit endpoint (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: confirmation email is sent via Supabase Auth SMTP automatically.
# Public site URL (used in metadata / emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
